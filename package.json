{
  "name": "network-pilot",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "check:no-remote-fonts": "node scripts/check-no-remote-fonts.mjs",
    "check:no-email-send": "node scripts/check-no-email-send.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "apollo:validate-search": "tsx scripts/apollo-live-search.ts",
    "apollo:validate-enrichment": "tsx scripts/apollo-live-enrichment.ts",
    "apollo:controlled-batch": "tsx scripts/apollo-controlled-real-batch.ts",
    "apollo:operational-scale": "tsx scripts/apollo-operational-scale-batch.ts",
    "gmail:controlled-live": "tsx scripts/gmail-controlled-live-validation.ts",
    "gmail:human-reviewed-pilot": "tsx scripts/gmail-human-reviewed-pilot.ts",
    "manual-send:confirm": "tsx scripts/confirm-manual-send.ts",
    "manual-outreach:outcome": "tsx scripts/report-manual-outcome.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  }
}
